# ── Application ────────────────────────────────────────────────────────────────
DEBUG=false
# Host port (bound to 127.0.0.1; Cloudflare Tunnel provides public access)
WEB_PORT=5000

# Required, 32+ characters. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# true when deployed behind Cloudflare Tunnel / a reverse proxy. Trusts its
# X-Forwarded-* headers, forces secure cookies, and refuses to start without SSO.
BEHIND_PROXY=false

# Send the session cookie over HTTPS only. The dev compose file sets this to
# false; it is always on when BEHIND_PROXY=true.
COOKIE_SECURE=true

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_DB=rubricops
POSTGRES_USER=rubricops
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql+psycopg2://rubricops:changeme@db:5432/rubricops

# ── SSO — Microsoft Entra ID ───────────────────────────────────────────────────
# Leave all three blank for local development: a password-less dev login
# (email only) is shown instead. Set all three or none.
# Register an app at https://portal.azure.com → App registrations
# Redirect URI (Web): https://your-domain/auth/callback
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Your directory (tenant) ID. "common" accepts any Microsoft account, so then
# ALLOWED_DOMAINS must be set.
AZURE_TENANT_ID=

# ── Authorization ──────────────────────────────────────────────────────────────
# Comma-separated emails that receive the admin role on login
ADMIN_EMAILS=you@district.edu

# Comma-separated email domains allowed to sign in.
# Leave blank to allow every account that authenticates.
ALLOWED_DOMAINS=district.edu

# Role assigned to new users not in ADMIN_EMAILS: viewer | contributor | evaluator
DEFAULT_USER_ROLE=viewer

# Max login attempts per IP (per Gunicorn worker)
LOGIN_RATE_LIMIT=10 per minute

# ── Evidence file storage ──────────────────────────────────────────────────────
# Only "local" is supported today (a Docker volume at EVIDENCE_DIR)
STORAGE_BACKEND=local
EVIDENCE_DIR=/app/evidence
MAX_UPLOAD_BYTES=52428800

# ── Background jobs ────────────────────────────────────────────────────────────
# Weekly stale/expiring evidence and overdue task checks (logged)
SCHEDULER_ENABLED=true

# ── Runtime ────────────────────────────────────────────────────────────────────
GUNICORN_WORKERS=2

# ── Seed ───────────────────────────────────────────────────────────────────────
# Name of the organization created on first start (rename later in Admin)
SEED_TENANT_NAME=Lakeside School District
