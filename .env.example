# ── Application ────────────────────────────────────────────────────────────────
DEBUG=false
WEB_PORT=5000

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE-ME-USE-A-STRONG-RANDOM-SECRET

# Set to false ONLY for local HTTP-only development (no HTTPS)
COOKIE_SECURE=true

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_DB=rubricops
POSTGRES_USER=rubricops
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql+psycopg2://rubricops:changeme@db:5432/rubricops

# ── OIDC — Microsoft 365 ───────────────────────────────────────────────────────
# Register an app at https://portal.azure.com → App registrations
# Redirect URI: https://your-domain/auth/callback
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Use "common" for multi-tenant, or your directory (tenant) ID for single-tenant
AZURE_TENANT_ID=common

# ── Authorization ──────────────────────────────────────────────────────────────
# Comma-separated emails that receive the admin role on first login
ADMIN_EMAILS=you@district.edu

# Comma-separated email domains allowed to log in.
# Leave blank to allow all authenticated Microsoft accounts.
ALLOWED_DOMAINS=district.edu

# Role assigned to new users not in ADMIN_EMAILS: viewer | contributor | evaluator
DEFAULT_USER_ROLE=viewer

# ── Evidence file storage ──────────────────────────────────────────────────────
EVIDENCE_DIR=/app/evidence
MAX_UPLOAD_BYTES=52428800

# ── Seed ───────────────────────────────────────────────────────────────────────
SEED_TENANT_NAME=Lakeside School District
